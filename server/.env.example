# LLM provider: gemini (Gemma)
LLM_PROVIDER=gemini

# Gemini native API (Gemma)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

FIELD_NAME=small business and livelihood development in the Philippines
CLIENT_ORIGIN=*
PORT=5001
# Set to 1 only while debugging: the reloader leaks processes on Windows.
DEBUG=0

PERSONA=
AUDIENCE=small business owners and livelihood program participants in the Philippines
TONE=clear, practical, and encouraging
EXTRA_RULES=Do not add details that are not in the context.

TEMPERATURE=0.2
HISTORY_MESSAGES=6

# RAG tuning (defaults shown; uncomment to override)
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.30
# RAG_CHUNK_CHARS=800
# RAG_CHUNK_OVERLAP=120
# RAG_CANDIDATES=20
# RAG_MAX_PER_SOURCE=3
# RAG_BM25_MIN=1.5
# RAG_RERANK=1
# RAG_RERANK_MODEL=openai/gpt-oss-20b
# RAG_RERANK_EFFORT=low
# WARMUP=1
# MAX_UPLOAD_BYTES=10485760
